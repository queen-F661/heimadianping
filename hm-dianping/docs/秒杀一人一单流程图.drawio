<mxfile host="app.diagrams.net" agent="WorkBuddy" version="24.7.17">
  <diagram id="page-req" name="1-请求线程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1-frame" value="请求线程（Tomcat）· 用户在这条线上等结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="640" height="630" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="① 取用户 id&lt;br&gt;UserHolder.getUser().getId()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="② 生成订单号（全程只生这一次）&lt;br&gt;redisIdWorker.nextId(&quot;order&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="134" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="③ 执行 Lua（展开看第 2 页）&lt;br&gt;ARGV[1]=voucherId · ARGV[2]=userId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="218" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="④ 判断返回值 r != 0 ?&lt;br&gt;int r = result.intValue()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="302" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r4b" value="返回失败，结束&lt;br&gt;1=库存不足 · 2=重复下单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="302" width="180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="⑤ 组装 VoucherOrder&lt;br&gt;setId · setUserId · setVoucherId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="386" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="⑥ 缓存事务代理 → 丢进队列&lt;br&gt;AopContext.currentProxy() · orderTasks.add()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="⑦ 返回订单号，请求结束&lt;br&gt;return Result.ok(orderId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="554" width="340" height="54" as="geometry" />
        </mxCell>

        <mxCell id="e-r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r4a" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="r4" target="r4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r4b" value="r = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="r4" target="r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r5" target="r6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="r6" target="r7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-lua" name="2-Lua脚本内部">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-frame" value="Redis · Lua 原子执行（脚本跑完前，谁都插不进来）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="670" height="720" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="① 接参数&lt;br&gt;voucherId = ARGV[1] · userId = ARGV[2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="② 拼两个 key&lt;br&gt;seckill:stock:{卷号} · seckill:order:{卷号}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="134" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="③ 取库存并转成数字&lt;br&gt;stock = tonumber(GET stockkey)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="218" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="④ stock == nil 或 &amp;lt;= 0 ?&lt;br&gt;nil 必须先判，否则比较直接报错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="302" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l4b" value="return 1&lt;br&gt;库存不足，什么都不改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="302" width="180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="⑤ SISMEMBER orderkey userId == 1 ?&lt;br&gt;一人一单就靠这一句" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="386" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l5b" value="return 2&lt;br&gt;名单里有你，重复下单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="386" width="180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="⑥ 扣库存&lt;br&gt;INCRBY stockkey -1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l7" value="⑦ 把自己签进买家名单&lt;br&gt;SADD orderkey userId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="554" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l8" value="⑧ 返回成功&lt;br&gt;return 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="638" width="360" height="54" as="geometry" />
        </mxCell>

        <mxCell id="e-l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="l1" target="l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="l2" target="l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="l3" target="l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l4a" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="l4" target="l4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l4b" value="还够" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="l4" target="l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l5a" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="l5" target="l5b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l5b" value="没买过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="l5" target="l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="l6" target="l7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="l7" target="l8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-bg" name="3-后台线程落库">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-frame" value="后台线程（常驻单线程）· 用户已经走了，这里慢慢干" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="660" height="720" as="geometry" />
        </mxCell>

        <mxCell id="g0" value="⓪ @PostConstruct 启动（只执行一次）&lt;br&gt;submit(new VoucherOrderHandler())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="① take() 阻塞等待&lt;br&gt;没订单就挂起，不耗 CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="134" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="② 用 userId 上锁，tryLock 抢得到吗&lt;br&gt;getLock(&quot;lock:order:&quot; + userId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="218" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g2b" value="抢不到 → return&lt;br&gt;⚠ 这一单就丢了（原版隐患）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="218" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="③ 通过代理调事务方法&lt;br&gt;proxy.createVoucherOrder(voucherOrder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="302" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="④ 数据库查重 count &amp;gt; 0 ?&lt;br&gt;eq(user_id).eq(voucher_id).count()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="386" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g4b" value="买过了 → return&lt;br&gt;最后一道防线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="386" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="⑤ 扣库存（SQL 自己守底价）&lt;br&gt;UPDATE SET stock-1 WHERE stock &amp;gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g5b" value="影响 0 行 → return&lt;br&gt;说明库存真没了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="470" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="⑥ 插入订单 + finally 解锁&lt;br&gt;save(voucherOrder) · lock.unlock()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="554" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="回到 ① 继续 take()&lt;br&gt;这是个死循环，直到 running = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="638" width="340" height="54" as="geometry" />
        </mxCell>

        <mxCell id="e-g0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g0" target="g1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g1" target="g2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g2a" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;fontColor=#b8860b;" edge="1" parent="1" source="g2" target="g2b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g2b" value="抢到锁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="g2" target="g3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g3" target="g4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g4a" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="g4" target="g4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g4b" value="没买过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="g4" target="g5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g5a" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="g5" target="g5b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g5b" value="扣减成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="g5" target="g6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g6" target="g7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
